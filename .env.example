# Copy to .env and fill in. Never commit .env.

# Only needed for the Claude rule compiler (--mode auto). Without it the template parser is used.
ANTHROPIC_API_KEY=
ANOMALY_AGENT_MODEL=claude-sonnet-5-5

# Only needed with --send. Default is dry run (emails are written to outputs/emails/).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
